[Unit]
Description=proto background AI request service
Documentation=https://github.com/ech00f/proto

[Service]
Type=exec
ExecStart=:"@PROTO_BIN@" --daemon
Environment=PROTO_DAEMON_SOCKET=%t/proto/proto.sock
RuntimeDirectory=proto
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s
TimeoutStopSec=35s
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
LimitCORE=0
TasksMax=32

[Install]
WantedBy=default.target
